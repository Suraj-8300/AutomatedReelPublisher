# ==============================================================================
# AutoReelStudio Environment Configuration Template
# ==============================================================================

# 1. Meta Graph API (Instagram Reels Publishing)
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCOUNT_ID="17841400000000000"
INSTAGRAM_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_OR_PAGE_ACCESS_TOKEN"
META_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_OR_PAGE_ACCESS_TOKEN"
META_API_TIMEOUT=60
CONTAINER_POLL_INTERVAL=5
CONTAINER_POLL_TIMEOUT=300

# 2. Google Gemini API (Multimodal Video Analysis, Captions, Hooks & Hashtags)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_SCRIPT_MODEL="gemini-2.5-flash"

# 3. Direct Streaming & Ingestion (100% Free Direct Binary Upload to Meta)
STORAGE_PROVIDER=direct
