# ==============================================================================
# Instagram Reels Automated Pipeline Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Graph API Configuration
# ------------------------------------------------------------------------------
# Meta API Graph Version (v21.0 recommended)
META_GRAPH_API_VERSION=v21.0

# Your Instagram Professional / Creator / Business Account ID
# (Obtained via Graph API Explorer: GET /me/accounts -> {page-id}?fields=instagram_business_account)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Long-Lived System User or Page Access Token (requires instagram_content_publish, pages_show_list, instagram_basic)
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token

# API Timeouts and Polling
META_API_TIMEOUT=60
CONTAINER_POLL_INTERVAL=5
CONTAINER_POLL_TIMEOUT=300

# ------------------------------------------------------------------------------
# 2. Cloud Storage Bridge Configuration (Cloudflare R2, AWS S3, or MinIO)
# ------------------------------------------------------------------------------
# Provider: "r2", "s3", "minio", or "local"
STORAGE_PROVIDER=r2

# Bucket Name
S3_BUCKET_NAME=your-reels-bucket

# Cloudflare R2 Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS S3: leave empty or omit
S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com

# S3 Region (use "auto" for Cloudflare R2; "us-east-1", "eu-west-1", etc. for AWS S3)
S3_REGION_NAME=auto

# Access Keys
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Public URL Prefix (Cloudflare R2 Public Bucket URL or CDN Domain)
# e.g., https://pub-xxxxxx.r2.dev or https://media.yourdomain.com
# If empty, pipeline automatically generates pre-signed S3 URLs valid for 2 hours
S3_PUBLIC_URL_PREFIX=https://pub-yourbucket.r2.dev

# Automatically delete the cloud video object after Meta finishes ingesting it
AUTO_DELETE_CLOUD_OBJECT=true

# ------------------------------------------------------------------------------
# 3. Normalization & Queue Settings
# ------------------------------------------------------------------------------
# Scaling Mode for non-9:16 footage: "pad" (black letterbox), "crop" (center crop), "blur_pad" (blurred bg)
SCALING_MODE=pad

# Custom Queue Directories (defaults to ./reels_inbox, ./reels_processing, etc.)
# REELS_INBOX_DIR=/path/to/reels_inbox
# REELS_ARCHIVE_DIR=/path/to/reels_archive
# REELS_FAILED_DIR=/path/to/reels_failed

