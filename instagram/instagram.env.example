# ==============================================================================
# Instagram Reels Credentials & Cloud Storage Configuration
# ==============================================================================
# You can place your credentials here or in the root .env file.

META_GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token

# Cloud Storage Bridge (Cloudflare R2, AWS S3, MinIO, or zero-card tunnel)
STORAGE_PROVIDER=r2
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_URL_PREFIX=https://pub-xxxx.r2.dev
AUTO_DELETE_CLOUD_OBJECT=true
